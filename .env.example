# Copy to .env for local development. Never commit .env.
# In production (Cloud Run) the key comes from Secret Manager instead.

# Gemini API key from https://aistudio.google.com/api-keys
# Leave empty to run in offline fallback mode (every feature still works with templates).
GEMINI_API_KEY=

# Model ID — check https://ai.google.dev/gemini-api/docs/models for current stable IDs.
GEMINI_MODEL=gemini-3.8-flash

# Optional: MINIMAL | LOW | MEDIUM | HIGH. Leave empty to use the model default.
GEMINI_THINKING_LEVEL=

# Seconds to wait for Gemini before using the offline fallback.
AI_TIMEOUT_SECONDS=20

# Requests per minute allowed per client IP on /api routes.
RATE_LIMIT_PER_MINUTE=30
